{
    "name": "cpdiscordbot",
    "version": "1.0.0",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "npm run build && node dist/deploy-commands.js && node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "deploy": "tsx src/deploy-commands.ts",
        "devStart": "tsx watch src/index.ts",
        "cleardb": "tsx src/database/cleardb.ts",
        "format": "prettier . --write",
        "lint": "eslint .",
        "type-check": "tsc --noEmit",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "ThunderBlaze",
    "license": "ISC",
    "type": "module",
    "description": "A discord bot that fetches userdata from codechef",
    "dependencies": {
        "@discordjs/builders": "^1.10.1",
        "@discordjs/rest": "^2.4.3",
        "discord-api-types": "^0.37.119",
        "discord.js": "^14.18.0",
        "dotenv": "^16.4.7",
        "node-fetch": "^3.3.2",
        "nodemon": "^3.1.9",
        "prettier": "^3.5.0",
        "puppeteer": "^24.2.0",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "@types/sqlite3": "^3.1.11",
        "@typescript-eslint/eslint-plugin": "^8.58.2",
        "@typescript-eslint/parser": "^8.58.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    }
}
